# ── Diagnostics ──────────────────────────────────────────────────────────────
DEBUG=false
# Optional custom path for the MCP log file. Defaults to the working directory.
# LOG_PATH=C:\path\to\pdf-semantic-search.log

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=pdf_chunks

# ── Dense embeddings ──────────────────────────────────────────────────────────
# Any SentenceTransformer-compatible model name or local path
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Vector dimension must match the model output (all-MiniLM-L6-v2 → 384)
EMBEDDING_DIM=384
# Name of the dense named-vector field in Qdrant (default: "dense")
DENSE_VECTOR_NAME=dense

# ── Sparse embeddings (SPLADE++ via fastembed) ─────────────────────────────────
# Model downloaded once to ~/.cache/fastembed/ — no API key required
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1
# Name of the sparse named-vector field in Qdrant (default: "sparse")
SPARSE_VECTOR_NAME=sparse

# ── PDF Ingestion ─────────────────────────────────────────────────────────────
# Default chunk size in characters
DEFAULT_CHUNK_SIZE=512
# Overlap between consecutive chunks in characters
DEFAULT_CHUNK_OVERLAP=64
